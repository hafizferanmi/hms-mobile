# EXPO_PUBLIC_-prefixed vars are inlined into the JS bundle at build time
# (see https://docs.expo.dev/guides/environment-variables/), so this is
# fine to commit — it's just a URL, not a secret.
#
# Default points at hms-backend-node running locally (`yarn dev`, port 3001
# per its .env.example). That works as-is for the iOS Simulator and web,
# but not for:
#   - Android Emulator: use http://10.0.2.2:3001 instead of localhost
#   - a physical device: use your machine's LAN IP, e.g. http://192.168.x.x:3001
# Override per-machine in a git-ignored .env.local (see .gitignore) rather
# than editing this file.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001
